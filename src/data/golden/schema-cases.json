{
  "description": "validate.ts（TypeScript）與 web_schema.py（Python）共用的測試案例：同一份 schema 與值，兩邊都必須給出同樣的 ok／錯誤路徑。error 是錯誤訊息開頭的路徑（沒有 error 表示通過）。",
  "defs": {
    "Pair": {"tuple": ["number", "number"]}
  },
  "cases": [
    {"name": "number ok", "schema": "number", "value": 1.5, "ok": true},
    {"name": "number rejects string", "schema": "number", "value": "1", "ok": false, "path": "$"},
    {"name": "number rejects bool", "schema": "number", "value": true, "ok": false, "path": "$"},
    {"name": "number rejects null", "schema": "number", "value": null, "ok": false, "path": "$"},
    {"name": "int ok", "schema": "int", "value": 3, "ok": true},
    {"name": "int accepts 3.0 written as integer-valued float", "schema": "int", "value": 3.0, "ok": true},
    {"name": "int rejects 2.5", "schema": "int", "value": 2.5, "ok": false, "path": "$"},
    {"name": "int rejects bool", "schema": "int", "value": false, "ok": false, "path": "$"},
    {"name": "string ok", "schema": "string", "value": "abc", "ok": true},
    {"name": "string rejects number", "schema": "string", "value": 1, "ok": false, "path": "$"},
    {"name": "boolean ok", "schema": "boolean", "value": false, "ok": true},
    {"name": "boolean rejects 0", "schema": "boolean", "value": 0, "ok": false, "path": "$"},
    {"name": "null ok", "schema": "null", "value": null, "ok": true},
    {"name": "any accepts nested finite", "schema": "any", "value": {"a": [1, {"b": "x"}], "c": null}, "ok": true},
    {"name": "array ok", "schema": {"array": "number"}, "value": [1, 2, 3], "ok": true},
    {"name": "array empty ok", "schema": {"array": "number"}, "value": [], "ok": true},
    {"name": "array element error path", "schema": {"array": "number"}, "value": [1, "x", 3], "ok": false, "path": "$[1]"},
    {"name": "array fixed length ok", "schema": {"array": "number", "length": 2}, "value": [1, 2], "ok": true},
    {"name": "array fixed length mismatch", "schema": {"array": "number", "length": 3}, "value": [1, 2], "ok": false, "path": "$"},
    {"name": "array minLength", "schema": {"array": "number", "minLength": 2}, "value": [1], "ok": false, "path": "$"},
    {"name": "array rejects object", "schema": {"array": "number"}, "value": {"0": 1}, "ok": false, "path": "$"},
    {"name": "tuple ok", "schema": {"tuple": ["number", "string"]}, "value": [1, "a"], "ok": true},
    {"name": "tuple wrong length", "schema": {"tuple": ["number", "string"]}, "value": [1], "ok": false, "path": "$"},
    {"name": "tuple wrong element", "schema": {"tuple": ["number", "string"]}, "value": [1, 2], "ok": false, "path": "$[1]"},
    {"name": "object ok with extra key", "schema": {"object": {"a": "number"}}, "value": {"a": 1, "z": "extra"}, "ok": true},
    {"name": "object missing required", "schema": {"object": {"a": "number", "b": "string"}}, "value": {"a": 1}, "ok": false, "path": "$.b"},
    {"name": "object optional may be absent", "schema": {"object": {"a": "number", "b": "string"}, "optional": ["b"]}, "value": {"a": 1}, "ok": true},
    {"name": "object optional present must match", "schema": {"object": {"a": "number", "b": "string"}, "optional": ["b"]}, "value": {"a": 1, "b": 2}, "ok": false, "path": "$.b"},
    {"name": "object nested path", "schema": {"object": {"x": {"object": {"y": {"array": "number"}}}}}, "value": {"x": {"y": [1, null]}}, "ok": false, "path": "$.x.y[1]"},
    {"name": "object key needing quotes", "schema": {"object": {}, "rest": "number"}, "value": {"fx:bw 0.8": "bad"}, "ok": false, "path": "$[\"fx:bw 0.8\"]"},
    {"name": "object rest validates unlisted keys", "schema": {"object": {"a": "string"}, "rest": "number"}, "value": {"a": "s", "k1": 1, "k2": 2}, "ok": true},
    {"name": "object rest error", "schema": {"object": {"a": "string"}, "rest": "number"}, "value": {"a": "s", "k1": 1, "k2": "no"}, "ok": false, "path": "$.k2"},
    {"name": "object minKeys", "schema": {"object": {}, "rest": "number", "minKeys": 1}, "value": {}, "ok": false, "path": "$"},
    {"name": "object rejects array", "schema": {"object": {}}, "value": [], "ok": false, "path": "$"},
    {"name": "object rejects null", "schema": {"object": {}}, "value": null, "ok": false, "path": "$"},
    {"name": "sameLength ok", "schema": {"object": {"a": {"array": "number"}, "b": {"array": "number"}}, "sameLength": [["a", "b"]]}, "value": {"a": [1, 2], "b": [3, 4]}, "ok": true},
    {"name": "sameLength mismatch", "schema": {"object": {"a": {"array": "number"}, "b": {"array": "number"}}, "sameLength": [["a", "b"]]}, "value": {"a": [1, 2], "b": [3]}, "ok": false, "path": "$.b"},
    {"name": "sameLength skips absent optional", "schema": {"object": {"a": {"array": "number"}, "b": {"array": "number"}}, "optional": ["b"], "sameLength": [["a", "b"]]}, "value": {"a": [1, 2]}, "ok": true},
    {"name": "enum ok", "schema": {"enum": ["L1", "L2"]}, "value": "L2", "ok": true},
    {"name": "enum rejects other", "schema": {"enum": ["L1", "L2"]}, "value": "L3", "ok": false, "path": "$"},
    {"name": "oneOf nullable ok null", "schema": {"oneOf": ["number", "null"]}, "value": null, "ok": true},
    {"name": "oneOf nullable ok number", "schema": {"oneOf": ["number", "null"]}, "value": 2, "ok": true},
    {"name": "oneOf none matches", "schema": {"oneOf": ["number", "null"]}, "value": "x", "ok": false, "path": "$"},
    {"name": "ref ok", "schema": {"array": {"$ref": "Pair"}}, "value": [[1, 2], [3, 4]], "ok": true},
    {"name": "ref error path", "schema": {"array": {"$ref": "Pair"}}, "value": [[1, 2], [3, "x"]], "ok": false, "path": "$[1][1]"}
  ]
}
